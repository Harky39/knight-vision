{
  "action": {
    "default_icon": {
      "16": "favicon-16x16.png",
      "32": "favicon-32x32.png"
    },
    "default_popup": "popup.html",
    "default_title": "KnightVision \u2014 AI Chess Analysis"
  },
  "author": "Devin Wieker",
  "background": {
    "service_worker": "bg-loader.js"
  },
  "content_scripts": [
    {
      "js": [
        "jquery.js",
        "opening-book.js",
        "content.js"
      ],
      "matches": [
        "https://www.chess.com/play/*",
        "https://www.chess.com/game/*",
        "https://www.chess.com/puzzles/*",
        "https://www.chess.com/analysis/*"
      ]
    },
    {
      "js": [
        "ExtPay.js"
      ],
      "matches": [
        "https://extensionpay.com/*"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "description": "AI-powered chess analysis with Stockfish 18 for Chess.com.",
  "icons": {
    "128": "icon128.png",
    "16": "favicon-16x16.png",
    "32": "favicon-32x32.png"
  },
  "manifest_version": 3,
  "name": "KnightVision",
  "options_ui": {
    "open_in_tab": false,
    "page": "options.html"
  },
  "permissions": [
    "activeTab",
    "storage",
    "identity",
    "identity.email",
    "offscreen"
  ],
  "update_url": "https://clients2.google.com/service/update2/crx",
  "version": "1.0.1"
}
